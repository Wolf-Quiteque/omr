# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
# Found at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (S3-compatible)
# ─────────────────────────────────────────────────────────────
# Found at: https://dash.cloudflare.com/?to=/:account/r2/api-tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# Public domain you exposed for the bucket (custom domain or r2.dev URL).
# All uploaded image URLs are built as: ${R2_PUBLIC_BASE_URL}/${key}
R2_PUBLIC_BASE_URL=https://your-bucket.r2.dev

# ─────────────────────────────────────────────────────────────
# Admin (used by scripts/create-admin.mjs)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=josefa@gmail.com
ADMIN_PASSWORD=change-this-after-first-login
